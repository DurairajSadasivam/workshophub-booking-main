#!/usr/bin/env bash
# Husky pre-commit hook
# Runs branch name validation and REASONS structure lint before allowing a commit.

set -euo pipefail

echo "=== Pre-commit checks ==="
echo ""

# 1. Validate branch name (wh-<string>-<string> format)
echo "--- Branch name check ---"
scripts/branch-name-check.sh
echo ""

# 2. Lint REASONS structure of staged prompt files (or all if none staged)
echo "--- REASONS lint ---"
STAGED_PROMPT_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '^spdd/prompt/.*\.md$' || true)

if [ -n "$STAGED_PROMPT_FILES" ]; then
  echo "Linting staged prompt files..."
  # shellcheck disable=SC2086
  scripts/reasons-lint.sh $STAGED_PROMPT_FILES
else
  echo "No staged spdd/prompt/*.md files — running full REASONS lint..."
  scripts/reasons-lint.sh
fi

echo ""
echo "=== All pre-commit checks passed ==="
